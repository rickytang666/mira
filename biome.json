{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/.wasp", "!**/node_modules", "!**/migrations", "!**/public", "!**/.claude", "!**/.workspace"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single", "jsxQuoteStyle": "double" } },
  "css": { "formatter": { "quoteStyle": "single" } },
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noAutofocus": "off",
        "noLabelWithoutControl": "off",
        "noStaticElementInteractions": "off",
        "useButtonType": "off",
        "useKeyWithClickEvents": "off",
        "useSemanticElements": "off"
      },
      "correctness": { "useExhaustiveDependencies": "off" },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noDuplicateProperties": "off",
        "noShorthandPropertyOverrides": "off"
      }
    }
  }
}
