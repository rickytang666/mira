# Copy to .env.server and fill in. Never commit the real file.
# Local Postgres: createdb mira, then put your Mac username (whoami) before the @.
DATABASE_URL=postgresql://YOUR_USER@localhost:5432/mira
ELEVENLABS_API_KEY=
# Report summaries and question generation (server only).
OPENROUTER_API_KEY=
# DeepSeek V4.1 Flash with reasoning off: 1.1 s to first answer token, 171 tok/s (Artificial Analysis, Nov 2026); openrouter/free measured 16 s for questions and 33 s for a report.
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
# Turns reasoning off; without it, reasoning models take 15 to 20 s per call.
OPENROUTER_REASONING=off
