# Copy to .env.server and fill in. Never commit the real file.
# Local Postgres: createdb fieldwork, then put your Mac username (whoami) before the @.
DATABASE_URL=postgresql://YOUR_USER@localhost:5432/fieldwork
ELEVENLABS_API_KEY=
# Report summaries and question generation (server only).
OPENROUTER_API_KEY=
# Free router for initial testing; replace with an OpenRouter model ID to pin a model.
OPENROUTER_MODEL=openrouter/free
