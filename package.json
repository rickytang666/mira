{
  "name": "mira",
  "type": "module",
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "wasp start --client-port 3002 --server-port 3003",
    "compile": "wasp compile",
    "tunnels": "scripts/tunnels.sh",
    "dev:tunnel": "scripts/dev-tunnel.sh",
    "setup:agent": "node --env-file-if-exists=.env.server --env-file-if-exists=.env.client scripts/setup-agent.ts",
    "typecheck": "tsc -p tsconfig.src.json --noEmit && tsc -p tsconfig.scripts.json",
    "lint": "biome check .",
    "test": "vitest run",
    "verify": "wasp compile && npm run typecheck && npm run lint && npm run test",
    "doctor": "npx -y react-doctor@latest . --offline --fail-on none"
  },
  "workspaces": [
    ".wasp/out/*",
    ".wasp/out/sdk/wasp"
  ],
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "2.78.0",
    "@elevenlabs/react": "1.22.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "cheerio": "^1.0.0",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^5.0.0",
    "qrcode.react": "4.2.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router": "^8.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@wasp.sh/spec": "file:.wasp/spec/",
    "prisma": "5.19.1",
    "typescript": "6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
